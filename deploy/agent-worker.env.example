# Dedicated Agent Engine worker environment.
# Store real values in a secret manager or a root-readable EnvironmentFile.
NODE_ENV=production

# Existing AffiliateOS Google Cloud SQL PostgreSQL connection.
SQL_HOST=127.0.0.1
SQL_USER=affiliateos_agent_worker
SQL_PASSWORD=replace-with-secret
SQL_DB_NAME=affiliateos

# Gemini provider.
GEMINI_API_KEY=replace-with-secret
AGENT_ENGINE_MODEL=gemini-3.8-flash

# Project IDs must match IDs created in the Agent Engine admin panel.
# Values are trusted absolute paths on the dedicated worker VM.
AGENT_PROJECT_ROOTS={"affiliateos":"/opt/affiliateos"}

# Each project image must be private-registry image@sha256:<64 lowercase hex>.
AGENT_SANDBOX_IMAGES={"affiliateos":"registry.example.com/affiliateos-agent-checks@sha256:replace-with-64-hex-digest"}

# GitHub App installation token or fine-grained token; never pass to Docker containers.
AGENT_GITHUB_TOKEN=replace-with-secret
AGENT_GITHUB_PROJECTS={"affiliateos":{"owner":"YOUR_GITHUB_OWNER","repository":"Affiliate-1-fixed","baseBranch":"main"}}

# Safe defaults. Autonomous draft PR creation is opt-in.
AGENT_ALLOW_AUTONOMOUS_PR=false
AGENT_WORKER_POLL_MS=3000
AGENT_SANDBOX_TIMEOUT_MS=180000
AGENT_SANDBOX_MEMORY_MB=1024
AGENT_SANDBOX_CPUS=1
AGENT_SANDBOX_PIDS_LIMIT=128
AGENT_WORKSPACE_TEMP_ROOT=/var/lib/affiliateos-agent-worker
