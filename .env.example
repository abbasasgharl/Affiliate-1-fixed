# ---------------------------------------------------------------------------
# REQUIRED in production (the server refuses to start without SESSION_SECRET)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Signs session tokens and encrypts the stored SMTP password. >= 32 chars.
#   openssl rand -hex 48
SESSION_SECRET=

# One-time token needed to create the FIRST administrator (>= 16 chars).
# Without it the setup endpoint stays disabled, so nobody can claim a fresh install.
#   openssl rand -hex 24
SETUP_TOKEN=

# Public URL of the site (used for sitemap, canonical tags, robots.txt)
BASE_URL=https://your-domain.com

# Number of reverse proxies in front of Node (CyberPanel/OpenLiteSpeed, nginx, Cloud Run = 1).
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Database (PostgreSQL) - either a single URL or the individual parts
# ---------------------------------------------------------------------------
DATABASE_URL=
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Where click / contact alerts are sent (can also be set in Admin > Notifications)
OWNER_EMAIL=

# AI link analysis (Google Gemini)
GEMINI_API_KEY=

# SMTP fallback (can also be configured in the admin UI; password is stored encrypted)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=
